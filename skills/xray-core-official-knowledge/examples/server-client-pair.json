{
  "_comment": "Template for a version-locked server/client config pair.
    When adding examples, always include:
    1. target_version: the Xray Core version this example is validated against.
    2. protocol: the primary protocol in use.
    3. transport: the transport layer.
    4. server_only / client_only / must_match markers on each field.
    5. required / recommended / optional markers.
    6. A note on any experimental or version-locked features.
  ",
  "meta": {
    "target_version": "vX.X.X",
    "protocol": "VLESS",
    "transport": "XHTTP",
    "security": "REALITY",
    "verified": false
  },
  "server": {
    "inbounds": [
      {
        "protocol": "VLESS",
        "settings": {
          "clients": [
            {
              "id": "UUID",
              "_field_required": true,
              "_server_only": false,
              "_client_only": false,
              "_must_match": true
            }
          ],
          "decryption": "none",
          "_field_required": true,
          "_note": "Required for VLESS when using XTLS or REALITY."
        },
        "streamSettings": {
          "network": "xhttp",
          "security": "reality",
          "realitySettings": {}
        }
      }
    ]
  },
  "client": {
    "outbounds": [
      {
        "protocol": "VLESS",
        "settings": {
          "vnext": [
            {
              "address": "server-address",
              "port": 443,
              "users": [
                {
                  "id": "UUID",
                  "_field_required": true,
                  "_must_match": true
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "xhttp",
          "security": "reality",
          "realitySettings": {}
        }
      }
    ]
  }
}
